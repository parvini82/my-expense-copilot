# ==============================================================================
# Personal Expense Tracking AI Agent - Environment Configuration
# ==============================================================================

# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram Chat IDs (Comma-separated list for multi-user support)
ALLOWED_CHAT_IDS=11111111,22222222

# OpenRouter / LLM Configuration
# API key obtained from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-exp:free

# OpenAI Configuration (Optional: required for Whisper voice note transcription)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mobile Webhook Security
# Shared secret key passed in 'x-secret-key' header from mobile webhooks (e.g. iOS Shortcuts)
WEBHOOK_SECRET=change_me_to_a_secure_random_string

# Google Sheets Integration (Optional)
# Google Spreadsheet ID or Title (Make sure your Service Account email has Editor access)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Storage & Database Settings
DB_FILE_PATH=expenses.json
DEFAULT_CURRENCY=Toman

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
