# ==============================================================================
# Event-Driven Personal Expense Tracking AI Agent - Environment Configuration
# ==============================================================================

# Telegram Configuration
# ------------------------------------------------------------------------------
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The Telegram User/Chat ID allowed to interact with the bot (integer)
# Tip: Send /start to @userinfobot or check logs after sending a message to your bot
ALLOWED_CHAT_ID=123456789

# OpenRouter / LLM Configuration
# ------------------------------------------------------------------------------
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI Configuration (For Whisper Audio Transcription)
# ------------------------------------------------------------------------------
# OpenAI API key for speech-to-text transcription via Whisper API
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets Database Configuration
# ------------------------------------------------------------------------------
# Set the Document ID or Name of your Google Sheet
# (Found in the URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to the Google Service Account credentials JSON file
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Default currency label for expenses (e.g., Toman, Rial, USD, EUR)
DEFAULT_CURRENCY=Toman

# Mobile Webhook Security
# ------------------------------------------------------------------------------
# Secret key required in the 'x-secret-key' header for POST /webhook/mobile
WEBHOOK_SECRET=my_super_secret_webhook_key_12345

# Fallback Local Storage & Server Settings
# ------------------------------------------------------------------------------
DB_FILE_PATH=expenses.json
HOST=0.0.0.0
PORT=8000
DEBUG=false
